{
  "name": "teletype-sdk-rn",
  "version": "0.1.0",
  "description": "React Native SDK for embedding the Teletype online chat into iOS and Android apps. Reimplements the Teletype web widget protocol (REST + socket.io) natively.",
  "license": "MIT",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "README.md",
    "README_RUS.md"
  ],
  "keywords": [
    "react-native",
    "teletype",
    "chat",
    "livechat",
    "support",
    "widget",
    "sdk",
    "ios",
    "android"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run copy:i18n",
    "copy:i18n": "mkdir -p lib/commonjs/i18n && cp src/i18n/*.json lib/commonjs/i18n/ && mkdir -p lib/commonjs/ui/svg/ChatButtonSvg && cp src/ui/svg/ChatButtonSvg/*.png lib/commonjs/ui/svg/ChatButtonSvg/ && mkdir -p lib/commonjs/ui/backgrounds && cp src/ui/backgrounds/*.png lib/commonjs/ui/backgrounds/",
    "clean": "rimraf lib",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.68.0",
    "@react-native-async-storage/async-storage": ">=1.21.0",
    "@react-native-community/slider": ">=4.5.0",
    "@react-native-documents/viewer": ">=1.0.0",
    "react-native-blob-util": ">=0.19.0",
    "react-native-create-thumbnail": ">=2.0.0",
    "react-native-image-zoom-viewer": ">=3.0.0",
    "react-native-video": ">=6.0.0",
    "react-native-vector-icons": ">=10.0.0",
    "react-native-safe-area-context": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": { "optional": true },
    "@react-native-community/slider": { "optional": true },
    "@react-native-documents/viewer": { "optional": true },
    "react-native-blob-util": { "optional": true },
    "react-native-create-thumbnail": { "optional": true },
    "react-native-image-zoom-viewer": { "optional": true },
    "react-native-video": { "optional": true },
    "react-native-vector-icons": { "optional": true },
    "react-native-safe-area-context": { "optional": true }
  },
  "dependencies": {
    "socket.io-client": "^2.5.0"
  },
  "optionalDependencies": {
    "@react-native-async-storage/async-storage": "^1.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "@types/socket.io-client": "^1.4.36",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.9.0"
  }
}
